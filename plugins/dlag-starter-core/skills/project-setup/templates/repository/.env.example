# Starter environment-name proposal, never real values.
# The role does not write .env or Worker configuration. Keep public values
# separate from Worker secrets. Confirm actual keys from installed application code.
# Frontend-safe Supabase project identifiers, subject to the installed SDK's names:
VITE_SUPABASE_URL=https://example.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me-public-placeholder
# Never expose service-role/secret keys, database credentials, Stripe secrets,
# webhook secrets or Resend API keys through VITE_ variables or browser code.
# Cloudflare secrets owns server secrets; R2 uses Worker bindings, not client keys.
# Server names below are documentation placeholders only, not all required:
SUPABASE_URL=https://example.invalid
SUPABASE_SECRET_KEY=replace-me-server-only
RESEND_API_KEY=replace-me-server-only
# Optional hosted Checkout only, when the project actually requires Stripe:
STRIPE_SECRET_KEY=replace-me-server-only
STRIPE_WEBHOOK_SECRET=replace-me-server-only
# Optional migration-only database URL belongs in a separate authorized server
# workflow, never browser config. Do not seed a connection string or read a real one.
# R2 binding names and public/private access policy are recorded separately.
